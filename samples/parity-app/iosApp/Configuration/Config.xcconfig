TEAM_ID=
BUNDLE_ID=org.meshtastic.sdk.sample.parity
APP_NAME=Meshtastic Parity Sample

// The Kotlin side no longer declares iosX64 (Compose Multiplatform 1.11 dropped
// Apple x86_64), so an x86_64 simulator slice can never be produced. Generic
// simulator destinations otherwise request ARCHS="arm64 x86_64" and break the
// Compose resource sync ("Unknown iOS simulator arch: 'x86_64'").
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
