{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(UTC)"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "configMigration": true,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false
    },
    {
      "matchPackageNames": ["org.meshtastic:protobufs"],
      "automerge": false,
      "prBodyNotes": [
        "Bumps the `org.meshtastic:protobufs` artifact (the wire schema). Review the regenerated API diff carefully — new `oneof` arms break exhaustive `when` for consumers; run `./gradlew updateKotlinAbi`. See `docs/versioning.md`."
      ]
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/"
      ]
    },
    {
      "groupName": "ktor",
      "matchPackageNames": [
        "/^io\\.ktor/"
      ]
    },
    {
      "groupName": "sqldelight",
      "matchPackageNames": [
        "/^app\\.cash\\.sqldelight/"
      ]
    },
    {
      "groupName": "kable",
      "matchPackageNames": [
        "/^com\\.juul\\.kable/"
      ]
    },
    {
      "groupName": "wire",
      "matchPackageNames": [
        "/^com\\.squareup\\.wire/"
      ]
    },
    {
      "groupName": "kotlinx",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlinx/"
      ]
    }
  ],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] }
}
